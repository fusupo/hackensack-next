{
  // The embeddable player (packages/player). It runs in pages, so it gets the
  // DOM lib; it reaches the engine through @hackensack/engine only.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.player.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@hackensack/engine": ["./packages/engine/src/index.ts"]
    },
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["packages/player/src"],
  "exclude": ["packages/player/src/**/*.test.ts"]
}
