{
  // Tests run in Node (vitest environment "node"), so they get Node types but
  // no DOM. Editor tests that need a DOM would need their own setup.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@hackensack/engine": ["./packages/engine/src/index.ts"]
    },
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.test.ts",
    "server/**/*.test.ts",
    "packages/*/src/**/*.test.ts",
    "scripts/**/*.test.ts"
  ]
}
