{
  "format": "hackensack/2",
  "inputs": {
    "l": { "type": "list" },
    "cy": { "type": "number" },
    "color": { "type": "string", "default": "#ffffff" }
  },
  "root": "n0",
  "nodes": {
    "n0": {
      "type": "svg",
      "params": { "width": 400, "height": 400 },
      "children": ["n1"]
    },
    "n1": {
      "type": "g",
      "params": { "transform": "translate(200, 200)" },
      "children": ["n2"]
    },
    "n2": { "type": "each", "params": { "list": "l" }, "children": ["n3"] },
    "n3": {
      "type": "component",
      "ref": "spoke",
      "params": { "angle": "i / count(l) * 2 * pi", "length": "cy" }
    }
  }
}
